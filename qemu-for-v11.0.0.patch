index 22325324d..964a3964d 100644
--- a/include/hw/i386/pc.h
+++ b/include/hw/i386/pc.h
@@ -107,6 +107,36 @@ struct PCMachineClass {
     /* RAM / address space compat: */
     bool gigabyte_align;
     bool has_reserved_memory;
+    /*
+     * 在以下使用PCMachineClass->enforce_amd_1tb_hole:
+     *   - hw/i386/pc.c|762| <<pc_memory_init>> if (IS_AMD_CPU(&cpu->env) && pcmc->enforce_amd_1tb_hole) {
+     *   - hw/i386/pc.c|1646| <<pc_machine_class_init>> pcmc->enforce_amd_1tb_hole = true;
+     *   - hw/i386/pc_piix.c|561| <<pc_i440fx_machine_7_0_options>> pcmc->enforce_amd_1tb_hole = false;
+     *   - hw/i386/pc_q35.c|493| <<pc_q35_machine_7_0_options>> pcmc->enforce_amd_1tb_hole = false;
+     *
+     * enforce_amd_1tb_hole 是 QEMU x86 PC 机器类型里的一个兼容开关, 用来处理
+     * AMD IOMMU 在接近 1TiB 地址处保留的 HyperTransport GPA 区间.
+     *
+     * - AMD IOMMU 有一段不能用于 DMA map 的 guest physical address:
+     *   0xfd00000000 - 0xffffffffff，也就是 1TiB 前面的 12GiB.
+     * - 如果 vCPU 是 AMD, 并且 enforce_amd_1tb_hole = true, QEMU 会:
+     * 1. 如果可能使用到这段 HT 保留区, 就把 ram-above-4g 的起始地址挪到
+     * 0x10000000000, 也就是 1TiB 之后.
+     * 2. 如果 CPU 物理地址宽度达到 40 bit, 就通过 E820 把这段区域报告给 guest
+     * 为 E820_RESERVED.
+     *
+     * 这里的 40 bit 指 vCPU 暴露给 guest 的物理地址宽度, 不是随便的阈值.
+     * 2^40 = 0x10000000000 = 1 TiB
+     * AMD 这段 HyperTransport reserved GPA 是:
+     * 0xfd00000000 - 0xffffffffff
+     *
+     * 所以关系是:
+     *
+     * - 如果 phys_bits < 40, guest 物理地址空间根本到不了 1TiB 附近,
+     * 这段地址对 guest 不存在, 没必要写进 E820.
+     * - 如果 phys_bits >= 40, guest 能表达/访问到这段 GPA, 那么 firmware/BIOS
+     * 就应该通过 E820 告诉 guest OS: 这段不是 RAM, 是 reserved.
+     */
     bool enforce_amd_1tb_hole;
     bool isa_bios_alias;
 
