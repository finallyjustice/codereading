diff --git a/accel/kvm/kvm-all.c b/accel/kvm/kvm-all.c
index 92af42503..85e3652f8 100644
--- a/accel/kvm/kvm-all.c
+++ b/accel/kvm/kvm-all.c
@@ -2885,6 +2885,15 @@ static int kvm_reset_vmfd(MachineState *ms)
      * can call synchronize_all_post_init() to sync all vcpu states to
      * kvm.
      */
+    /*
+     * 在以下使用cpu_synchronize_all_post_init():
+     *   - accel/kvm/kvm-all.c|2889| <<kvm_reset_vmfd>> cpu_synchronize_all_post_init();
+     *   - hw/core/machine.c|1717| <<qdev_machine_creation_done>> cpu_synchronize_all_post_init();
+     *   - migration/savevm.c|2146| <<loadvm_postcopy_handle_run_bh>> cpu_synchronize_all_post_init();
+     *   - migration/savevm.c|3147| <<qemu_loadvm_state>> cpu_synchronize_all_post_init();
+     *   - migration/savevm.c|3171| <<qemu_load_device_state>> cpu_synchronize_all_post_init();
+     *   - system/runstate.c|581| <<qemu_system_reset>> cpu_synchronize_all_post_init();
+     */
     if (ms->cgs) {
         cpu_synchronize_all_post_init();
     }
@@ -4763,6 +4772,11 @@ void kvm_mark_guest_state_protected(void)
     kvm_state->guest_state_protected = true;
 }
 
+/*
+ * 在以下使用kvm_create_guest_memfd():
+ *   - system/physmem.c|2247| <<ram_block_add>> new_block->guest_memfd = kvm_create_guest_memfd(new_block->max_length,
+ *   - system/physmem.c|2975| <<ram_block_rebind>> block->guest_memfd = kvm_create_guest_memfd(block->max_length,
+ */
 int kvm_create_guest_memfd(uint64_t size, uint64_t flags, Error **errp)
 {
     int fd;
diff --git a/backends/hostmem-memfd.c b/backends/hostmem-memfd.c
index 923239f9c..0f176bf9b 100644
--- a/backends/hostmem-memfd.c
+++ b/backends/hostmem-memfd.c
@@ -30,11 +30,28 @@ struct HostMemoryBackendMemfd {
     bool seal;
 };
 
+/*
+ * 在以下使用memfd_backend_memory_alloc():
+ *   - backends/hostmem-memfd.c|166| <<memfd_backend_class_init>> bc->alloc = memfd_backend_memory_alloc;
+ */
 static bool
 memfd_backend_memory_alloc(HostMemoryBackend *backend, Error **errp)
 {
     HostMemoryBackendMemfd *m = MEMORY_BACKEND_MEMFD(backend);
     g_autofree char *name = host_memory_backend_get_name(backend);
+    /*
+     * 在以下使用cpr_find_fd():
+     *   - backends/hostmem-memfd.c|38| <<memfd_backend_memory_alloc>> int fd = cpr_find_fd(name, 0);
+     *   - backends/hostmem-shm.c|31| <<shm_backend_memory_alloc>> int fd = cpr_find_fd(backend_name, 0);
+     *   - backends/iommufd.c|81| <<iommufd_backend_complete>> be->fd = cpr_find_fd(name, 0);
+     *   - hw/vfio/container-legacy.c|621| <<vfio_container_connect>> fd = cpr_find_fd("vfio_container_for_group", group->groupid);
+     *   - hw/vfio/cpr-iommufd.c|238| <<vfio_cpr_load_device>> vbasedev->fd = cpr_find_fd(vbasedev->name, 0);
+     *   - hw/vfio/cpr-legacy.c|275| <<vfio_cpr_group_get_device_fd>> int fd = cpr_find_fd(name, id);
+     *   - hw/vfio/cpr.c|45| <<vfio_cpr_load_vector_fd>> return cpr_find_fd(fdname, nr);
+     *   - migration/cpr.c|115| <<cpr_open_fd>> int fd = cpr_find_fd(name, id);
+     *   - migration/cpr.c|321| <<cpr_get_fd_param>> fd = cpr_find_fd(name, index);
+     *   - system/physmem.c|2459| <<qemu_ram_get_shared_fd>> int fd = cpr_find_fd(name, 0);
+     */
     int fd = cpr_find_fd(name, 0);
     uint32_t ram_flags;
 
@@ -47,6 +64,14 @@ memfd_backend_memory_alloc(HostMemoryBackend *backend, Error **errp)
         goto have_fd;
     }
 
+    /*
+     * 在以下使用qemu_memfd_create():
+     *   - backends/hostmem-memfd.c|63| <<memfd_backend_memory_alloc>> fd = qemu_memfd_create(TYPE_MEMORY_BACKEND_MEMFD, backend->size,
+     *   - migration/cpr-exec.c|157| <<cpr_exec_output>> mfd = qemu_memfd_create(CPR_EXEC_STATE_NAME, 0, false, 0, 0, errp);
+     *   - system/physmem.c|2516| <<qemu_ram_get_shared_fd>> fd = qemu_memfd_create(name, 0, 0, 0, 0, errp);
+     *   - util/memfd.c|112| <<qemu_memfd_alloc>> int mfd = qemu_memfd_create(name, size, false, 0, seals, NULL);
+     *   - util/memfd.c|116| <<qemu_memfd_alloc>> mfd = qemu_memfd_create(name, size, false, 0, 0, NULL);
+     */
     fd = qemu_memfd_create(TYPE_MEMORY_BACKEND_MEMFD, backend->size,
                            m->hugetlb, m->hugetlbsize, m->seal ?
                            F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL : 0,
@@ -54,6 +79,19 @@ memfd_backend_memory_alloc(HostMemoryBackend *backend, Error **errp)
     if (fd == -1) {
         return false;
     }
+    /*
+     * 在以下使用cpr_save_fd():
+     *   - backends/hostmem-memfd.c|70| <<memfd_backend_memory_alloc>> cpr_save_fd(name, 0, fd);
+     *   - backends/hostmem-shm.c|64| <<shm_backend_memory_alloc>> cpr_save_fd(backend_name, 0, fd);
+     *   - backends/iommufd.c|96| <<iommufd_backend_complete>> cpr_save_fd(name, 0, be->fd);
+     *   - hw/vfio/cpr-legacy.c|293| <<vfio_cpr_group_get_device_fd>> cpr_save_fd(name, id, fd);
+     *   - hw/vfio/cpr-legacy.c|322| <<vfio_cpr_container_match>> cpr_save_fd("vfio_container_for_group", group->groupid, container->fd);
+     *   - hw/vfio/cpr.c|39| <<vfio_cpr_save_vector_fd>> cpr_save_fd(fdname, nr, fd);
+     *   - migration/cpr.c|228| <<cpr_resave_fd>> cpr_save_fd(name, id, fd);
+     *   - migration/cpr.c|258| <<cpr_open_fd>> cpr_save_fd(name, id, fd);
+     *   - migration/cpr.c|533| <<cpr_get_fd_param>> cpr_save_fd(name, index, fd);
+     *   - system/physmem.c|2514| <<qemu_ram_get_shared_fd>> cpr_save_fd(name, 0, fd);
+     */
     cpr_save_fd(name, 0, fd);
 
 have_fd:
