 {
     g_autofree char *backend_name = host_memory_backend_get_name(backend);
     uint32_t ram_flags;
+    /*
+     * 在以下使用cpr_find_fd():
+     *   - backends/hostmem-memfd.c|38| <<memfd_backend_memory_alloc>> int fd = cpr_find_fd(name, 0);
+     *   - backends/hostmem-shm.c|31| <<shm_backend_memory_alloc>> int fd = cpr_find_fd(backend_name, 0);
+     *   - backends/iommufd.c|81| <<iommufd_backend_complete>> be->fd = cpr_find_fd(name, 0);
+     *   - hw/vfio/container-legacy.c|621| <<vfio_container_connect>> fd = cpr_find_fd("vfio_container_for_group", group->groupid);
+     *   - hw/vfio/cpr-iommufd.c|238| <<vfio_cpr_load_device>> vbasedev->fd = cpr_find_fd(vbasedev->name, 0);
+     *   - hw/vfio/cpr-legacy.c|275| <<vfio_cpr_group_get_device_fd>> int fd = cpr_find_fd(name, id);
+     *   - hw/vfio/cpr.c|45| <<vfio_cpr_load_vector_fd>> return cpr_find_fd(fdname, nr);
+     *   - migration/cpr.c|115| <<cpr_open_fd>> int fd = cpr_find_fd(name, id);
+     *   - migration/cpr.c|321| <<cpr_get_fd_param>> fd = cpr_find_fd(name, index);
+     *   - system/physmem.c|2459| <<qemu_ram_get_shared_fd>> int fd = cpr_find_fd(name, 0);
+     */
     int fd = cpr_find_fd(backend_name, 0);
 
     if (!backend->size) {
@@ -48,6 +61,19 @@ shm_backend_memory_alloc(HostMemoryBackend *backend, Error **errp)
     if (fd < 0) {
         return false;
     }
+    /*
+     * 在以下使用cpr_save_fd():
+     *   - backends/hostmem-memfd.c|70| <<memfd_backend_memory_alloc>> cpr_save_fd(name, 0, fd);
+     *   - backends/hostmem-shm.c|64| <<shm_backend_memory_alloc>> cpr_save_fd(backend_name, 0, fd);
+     *   - backends/iommufd.c|96| <<iommufd_backend_complete>> cpr_save_fd(name, 0, be->fd);
+     *   - hw/vfio/cpr-legacy.c|293| <<vfio_cpr_group_get_device_fd>> cpr_save_fd(name, id, fd);
+     *   - hw/vfio/cpr-legacy.c|322| <<vfio_cpr_container_match>> cpr_save_fd("vfio_container_for_group", group->groupid, container->fd);
+     *   - hw/vfio/cpr.c|39| <<vfio_cpr_save_vector_fd>> cpr_save_fd(fdname, nr, fd);
+     *   - migration/cpr.c|228| <<cpr_resave_fd>> cpr_save_fd(name, id, fd);
+     *   - migration/cpr.c|258| <<cpr_open_fd>> cpr_save_fd(name, id, fd);
+     *   - migration/cpr.c|533| <<cpr_get_fd_param>> cpr_save_fd(name, index, fd);
+     *   - system/physmem.c|2514| <<qemu_ram_get_shared_fd>> cpr_save_fd(name, 0, fd);
