+	 */
         fd = cpr_open_fd("/dev/iommu", O_RDWR, iommufd_fd_name(be), 0, errp);
         if (fd < 0) {
             return false;
@@ -155,6 +186,21 @@ void iommufd_backend_disconnect(IOMMUFDBackend *be)
     if (!be->users) {
         vfio_iommufd_cpr_unregister_iommufd(be);
         if (be->owned) {
+            /*
+	     * 在以下使用cpr_delete_fd():
+             *   - backends/iommufd.c|189| <<iommufd_backend_disconnect>> cpr_delete_fd(iommufd_fd_name(be), 0);
+             *   - hw/vfio/container-legacy.c|606| <<vfio_container_group_del>> cpr_delete_fd("vfio_container_for_group", group->groupid);
+             *   - hw/vfio/container-legacy.c|744| <<vfio_container_disconnect>> cpr_delete_fd("vfio_container_for_group", group->groupid);
+             *   - hw/vfio/container-legacy.c|835| <<vfio_group_get>> cpr_delete_fd("vfio_group", groupid);
+             *   - hw/vfio/container-legacy.c|857| <<vfio_group_put>> cpr_delete_fd("vfio_group", group->groupid);
+             *   - hw/vfio/container-legacy.c|916| <<vfio_device_get>> cpr_delete_fd(name, 0);
+             *   - hw/vfio/container-legacy.c|928| <<vfio_device_put>> cpr_delete_fd(vbasedev->name, 0);
+             *   - hw/vfio/cpr-iommufd.c|274| <<vfio_iommufd_cpr_unregister_device>> cpr_delete_fd(vbasedev->name, 0);
+             *   - hw/vfio/cpr-legacy.c|344| <<vfio_cpr_container_match>> cpr_delete_fd("vfio_container_for_group", group->groupid);
+             *   - hw/vfio/cpr.c|77| <<vfio_cpr_delete_vector_fd>> cpr_delete_fd(fdname, nr);
+             *   - system/physmem.c|2607| <<qemu_ram_alloc_internal>> cpr_delete_fd(name, 0);
+             *   - system/physmem.c|2708| <<qemu_ram_free>> cpr_delete_fd(name, 0);
+	     */
             cpr_delete_fd(iommufd_fd_name(be), 0);
             close(be->fd);
             be->fd = -1;
