diff --git a/arch/x86/kvm/x86.c b/arch/x86/kvm/x86.c
index 47cb9eba1..e5efc67de 100644
--- a/arch/x86/kvm/x86.c
+++ b/arch/x86/kvm/x86.c
@@ -3759,6 +3759,29 @@ static void record_steal_time(struct kvm_vcpu *vcpu)
 		u8 st_preempted = 0;
 		int err = -EFAULT;
 
+		/*
+		 * 作用大概是:
+		 *
+		 * 1. 检查用户地址范围
+		 * 确认 ptr..ptr+len 是合法 user address 范围,
+		 * 不是内核地址或明显越界地址.
+		 * 2. 打开短窗口允许 user memory access
+		 * 在一些架构上, 内核默认禁止直接访问用户页;
+		 * user_access_begin() 会临时打开权限, 后面必须用
+		 * user_access_end() 关掉.
+		 * 3. 配合 exception table 处理 fault
+		 * unsafe_get_user() / unsafe_put_user() 如果访问用户页 fault,
+		 * 会跳到指定 label, 而不是直接 oops.
+		 *
+		 * 意思是: st 指向 guest 提供的 steal-time shared page
+		 * 映射地址, 但从 host kernel 看仍然是 user mapping,
+		 * 所以写它前要先进入 user access 区间. 失败就不能碰这个地址.
+		 *
+		 * 和普通 get_user() / put_user() 的区别是: user_access_begin()
+		 * + unsafe_*_user() 适合一段连续多次 user access,
+		 * 少做重复检查, 性能更好, 但必须小心保证所有路径都正确
+		 * user_access_end().
+		 */
 		if (!user_access_begin(st, sizeof(*st)))
 			return;
 
@@ -5220,6 +5243,10 @@ void kvm_arch_vcpu_load(struct kvm_vcpu *vcpu, int cpu)
 	kvm_make_request(KVM_REQ_STEAL_UPDATE, vcpu);
 }
 
+/*
+ * 在以下使用kvm_steal_time_set_preempted():
+ *   - arch/x86/kvm/x86.c|5291| <<kvm_arch_vcpu_put>> kvm_steal_time_set_preempted(vcpu);
+ */
 static void kvm_steal_time_set_preempted(struct kvm_vcpu *vcpu)
 {
 	struct gfn_to_hva_cache *ghc = &vcpu->arch.st.cache;
