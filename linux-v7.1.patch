+++ b/arch/arm64/include/asm/kvm_host.h
@@ -322,6 +322,23 @@ struct kvm_arch {
 	 * Stage 2 paging state for VMs with nested S2 using a virtual
 	 * VMID.
 	 */
+	/*
+	 * 在以下使用kvm_arch->nested_mmus:
+	 *   - arch/arm64/kvm/nested.c|653| <<global>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|48| <<kvm_init_nested>> kvm->arch.nested_mmus = NULL;
+	 *   - arch/arm64/kvm/nested.c|101| <<kvm_vcpu_init_nested>> memcpy(tmp, kvm->arch.nested_mmus,
+	 *   - arch/arm64/kvm/nested.c|108| <<kvm_vcpu_init_nested>> swap(kvm->arch.nested_mmus, tmp);
+	 *   - arch/arm64/kvm/nested.c|116| <<kvm_vcpu_init_nested>> ret = init_nested_s2_mmu(kvm, &kvm->arch.nested_mmus[i]);
+	 *   - arch/arm64/kvm/nested.c|120| <<kvm_vcpu_init_nested>> kvm_free_stage2_pgd(&kvm->arch.nested_mmus[i]);
+	 *   - arch/arm64/kvm/nested.c|695| <<lookup_s2_mmu>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|734| <<get_s2_mmu_nested>> s2_mmu = &kvm->arch.nested_mmus[i % kvm->arch.nested_mmus_size];
+	 *   - arch/arm64/kvm/nested.c|1151| <<kvm_nested_s2_wp>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1170| <<kvm_nested_s2_unmap>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1189| <<kvm_nested_s2_flush>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1201| <<kvm_arch_flush_shadow_all>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1206| <<kvm_arch_flush_shadow_all>> kvfree(kvm->arch.nested_mmus);
