+ *   - arch/arm64/kernel/paravirt.c|74| <<stolen_time_cpu_down_prepare>> reg = this_cpu_ptr(&stolen_time_region);
+ *   - arch/arm64/kernel/paravirt.c|91| <<stolen_time_cpu_online>> reg = this_cpu_ptr(&stolen_time_region);
+ */
 static DEFINE_PER_CPU(struct pv_time_stolen_time_region, stolen_time_region);
 
 static bool steal_acc = true;
@@ -47,6 +54,13 @@ static u64 para_steal_clock(int cpu)
 	struct pv_time_stolen_time_region *reg;
 	u64 ret = 0;
 
+	/*
+	 * 在以下使用stolen_time_region:
+	 *   - arch/arm64/kernel/paravirt.c|32| <<global>> static DEFINE_PER_CPU(struct pv_time_stolen_time_region, stolen_time_region);
+	 *   - arch/arm64/kernel/paravirt.c|50| <<para_steal_clock>> reg = per_cpu_ptr(&stolen_time_region, cpu);
+	 *   - arch/arm64/kernel/paravirt.c|74| <<stolen_time_cpu_down_prepare>> reg = this_cpu_ptr(&stolen_time_region);
+	 *   - arch/arm64/kernel/paravirt.c|91| <<stolen_time_cpu_online>> reg = this_cpu_ptr(&stolen_time_region);
+	 */
 	reg = per_cpu_ptr(&stolen_time_region, cpu);
 
 	/*
@@ -71,6 +85,13 @@ static int stolen_time_cpu_down_prepare(unsigned int cpu)
 	struct pvclock_vcpu_stolen_time *kaddr = NULL;
 	struct pv_time_stolen_time_region *reg;
 
+	/*
+	 * 在以下使用stolen_time_region:
+	 *   - arch/arm64/kernel/paravirt.c|32| <<global>> static DEFINE_PER_CPU(struct pv_time_stolen_time_region, stolen_time_region);
+	 *   - arch/arm64/kernel/paravirt.c|50| <<para_steal_clock>> reg = per_cpu_ptr(&stolen_time_region, cpu);
+	 *   - arch/arm64/kernel/paravirt.c|74| <<stolen_time_cpu_down_prepare>> reg = this_cpu_ptr(&stolen_time_region);
+	 *   - arch/arm64/kernel/paravirt.c|91| <<stolen_time_cpu_online>> reg = this_cpu_ptr(&stolen_time_region);
+	 */
 	reg = this_cpu_ptr(&stolen_time_region);
 	if (!reg->kaddr)
 		return 0;
@@ -88,6 +109,13 @@ static int stolen_time_cpu_online(unsigned int cpu)
 	struct pv_time_stolen_time_region *reg;
 	struct arm_smccc_res res;
 
+	/*
+	 * 在以下使用stolen_time_region:
+	 *   - arch/arm64/kernel/paravirt.c|32| <<global>> static DEFINE_PER_CPU(struct pv_time_stolen_time_region, stolen_time_region);
+	 *   - arch/arm64/kernel/paravirt.c|50| <<para_steal_clock>> reg = per_cpu_ptr(&stolen_time_region, cpu);
+	 *   - arch/arm64/kernel/paravirt.c|74| <<stolen_time_cpu_down_prepare>> reg = this_cpu_ptr(&stolen_time_region);
+	 *   - arch/arm64/kernel/paravirt.c|91| <<stolen_time_cpu_online>> reg = this_cpu_ptr(&stolen_time_region);
+	 */
 	reg = this_cpu_ptr(&stolen_time_region);
 
 	arm_smccc_1_1_invoke(ARM_SMCCC_HV_PV_TIME_ST, &res);
diff --git a/arch/arm64/kvm/nested.c b/arch/arm64/kvm/nested.c
index 6f7bc9a99..1b1e2c59c 100644
--- a/arch/arm64/kvm/nested.c
+++ b/arch/arm64/kvm/nested.c
@@ -1198,12 +1198,46 @@ void kvm_arch_flush_shadow_all(struct kvm *kvm)
 	int i;
 
 	for (i = 0; i < kvm->arch.nested_mmus_size; i++) {
+		/*
+		 * 在以下使用kvm_arch->nested_mmus:
+ 327          *   - arch/arm64/kvm/nested.c|653| <<global>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+ 328          *   - arch/arm64/kvm/nested.c|48| <<kvm_init_nested>> kvm->arch.nested_mmus = NULL;
+ 329          *   - arch/arm64/kvm/nested.c|101| <<kvm_vcpu_init_nested>> memcpy(tmp, kvm->arch.nested_mmus,
+ 330          *   - arch/arm64/kvm/nested.c|108| <<kvm_vcpu_init_nested>> swap(kvm->arch.nested_mmus, tmp);
+ 331          *   - arch/arm64/kvm/nested.c|116| <<kvm_vcpu_init_nested>> ret = init_nested_s2_mmu(kvm, &kvm->arch.nested_mmus[i]);
+ 332          *   - arch/arm64/kvm/nested.c|120| <<kvm_vcpu_init_nested>> kvm_free_stage2_pgd(&kvm->arch.nested_mmus[i]);
+ 333          *   - arch/arm64/kvm/nested.c|695| <<lookup_s2_mmu>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+ 334          *   - arch/arm64/kvm/nested.c|734| <<get_s2_mmu_nested>> s2_mmu = &kvm->arch.nested_mmus[i % kvm->arch.nested_mmus_size];
+ 335          *   - arch/arm64/kvm/nested.c|1151| <<kvm_nested_s2_wp>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+ 336          *   - arch/arm64/kvm/nested.c|1170| <<kvm_nested_s2_unmap>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+ 337          *   - arch/arm64/kvm/nested.c|1189| <<kvm_nested_s2_flush>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+ 338          *   - arch/arm64/kvm/nested.c|1201| <<kvm_arch_flush_shadow_all>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+ 339          *   - arch/arm64/kvm/nested.c|1206| <<kvm_arch_flush_shadow_all>> kvfree(kvm->arch.nested_mmus);
+ 340          *   - arch/arm64/kvm/nested.c|1207| <<kvm_arch_flush_shadow_all>> kvm->arch.nested_mmus = NULL;
+		 */
 		struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
 
 		if (!WARN_ON(atomic_read(&mmu->refcnt)))
 			kvm_free_stage2_pgd(mmu);
 	}
 	kvfree(kvm->arch.nested_mmus);
+	/*
+	 * 在以下使用kvm_arch->nested_mmus:
+	 *   - arch/arm64/kvm/nested.c|653| <<global>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|48| <<kvm_init_nested>> kvm->arch.nested_mmus = NULL;
+	 *   - arch/arm64/kvm/nested.c|101| <<kvm_vcpu_init_nested>> memcpy(tmp, kvm->arch.nested_mmus,
+	 *   - arch/arm64/kvm/nested.c|108| <<kvm_vcpu_init_nested>> swap(kvm->arch.nested_mmus, tmp);
+	 *   - arch/arm64/kvm/nested.c|116| <<kvm_vcpu_init_nested>> ret = init_nested_s2_mmu(kvm, &kvm->arch.nested_mmus[i]);
+	 *   - arch/arm64/kvm/nested.c|120| <<kvm_vcpu_init_nested>> kvm_free_stage2_pgd(&kvm->arch.nested_mmus[i]);
+	 *   - arch/arm64/kvm/nested.c|695| <<lookup_s2_mmu>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|734| <<get_s2_mmu_nested>> s2_mmu = &kvm->arch.nested_mmus[i % kvm->arch.nested_mmus_size];
+	 *   - arch/arm64/kvm/nested.c|1151| <<kvm_nested_s2_wp>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1170| <<kvm_nested_s2_unmap>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1189| <<kvm_nested_s2_flush>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1201| <<kvm_arch_flush_shadow_all>> struct kvm_s2_mmu *mmu = &kvm->arch.nested_mmus[i];
+	 *   - arch/arm64/kvm/nested.c|1206| <<kvm_arch_flush_shadow_all>> kvfree(kvm->arch.nested_mmus);
+	 *   - arch/arm64/kvm/nested.c|1207| <<kvm_arch_flush_shadow_all>> kvm->arch.nested_mmus = NULL;
+	 */
 	kvm->arch.nested_mmus = NULL;
 	kvm->arch.nested_mmus_size = 0;
 	kvm_uninit_stage2_mmu(kvm);
