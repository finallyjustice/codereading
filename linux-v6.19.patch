diff --git a/arch/arm64/kvm/sys_regs.c b/arch/arm64/kvm/sys_regs.c
index 88a57ca36..af0408d98 100644
--- a/arch/arm64/kvm/sys_regs.c
+++ b/arch/arm64/kvm/sys_regs.c
@@ -4099,6 +4099,14 @@ static bool handle_tlbi_el1(struct kvm_vcpu *vcpu, struct sys_reg_params *p,
 		.access = (access_fn),					\
 	}
 
+/*
+ * 在以下使用sys_insn_descs[]:
+ *   - arch/arm64/kvm/sys_regs.c|4102| <<global>> static struct sys_reg_desc sys_insn_descs[] = {
+ *   - arch/arm64/kvm/sys_regs.c|5181| <<kvm_handle_sys_reg>> desc = &sys_insn_descs[sr_idx];
+ *   - arch/arm64/kvm/sys_regs.c|5668| <<kvm_sys_reg_table_init>> valid &= check_sysreg_table(sys_insn_descs, ARRAY_SIZE(sys_insn_descs), false);
+ *   - arch/arm64/kvm/sys_regs.c|5685| <<kvm_sys_reg_table_init>> for (i = 0; !ret && i < ARRAY_SIZE(sys_insn_descs); i++)
+ *   - arch/arm64/kvm/sys_regs.c|5686| <<kvm_sys_reg_table_init>> ret = populate_sysreg_config(sys_insn_descs + i, i);
+ */
 static struct sys_reg_desc sys_insn_descs[] = {
 	{ SYS_DESC(SYS_DC_ISW), access_dcsw },
 	{ SYS_DESC(SYS_DC_IGSW), access_dcgsw },
@@ -4651,6 +4659,12 @@ int kvm_handle_cp14_load_store(struct kvm_vcpu *vcpu)
 	return 1;
 }
 
+/*
+ * 在以下使用perform_access():
+ *   - arch/arm64/kvm/sys_regs.c|4704| <<emulate_cp>> perform_access(vcpu, params, r);
+ *   - arch/arm64/kvm/sys_regs.c|4986| <<emulate_sys_reg>> perform_access(vcpu, params, r);
+ *   - arch/arm64/kvm/sys_regs.c|5183| <<kvm_handle_sys_reg>> perform_access(vcpu, &params, desc);
+ */
 static void perform_access(struct kvm_vcpu *vcpu,
 			   struct sys_reg_params *params,
 			   const struct sys_reg_desc *r)
@@ -5158,6 +5172,10 @@ void kvm_reset_sys_regs(struct kvm_vcpu *vcpu)
  *			 trap on a guest execution
  * @vcpu: The VCPU pointer
  */
+/*
+ * 在以下使用kvm_handle_sys_reg():
+ *   - arch/arm64/kvm/handle_exit.c|391| <<global>> [ESR_ELx_EC_SYS64] = kvm_handle_sys_reg,
+ */
 int kvm_handle_sys_reg(struct kvm_vcpu *vcpu)
 {
 	const struct sys_reg_desc *desc = NULL;
@@ -5174,6 +5192,14 @@ int kvm_handle_sys_reg(struct kvm_vcpu *vcpu)
 	params = esr_sys64_to_params(esr);
 	params.regval = vcpu_get_reg(vcpu, Rt);
 
+	/*
+	 * 在以下使用sys_insn_descs[]:
+	 *   - arch/arm64/kvm/sys_regs.c|4102| <<global>> static struct sys_reg_desc sys_insn_descs[] = {
+	 *   - arch/arm64/kvm/sys_regs.c|5181| <<kvm_handle_sys_reg>> desc = &sys_insn_descs[sr_idx];
+	 *   - arch/arm64/kvm/sys_regs.c|5668| <<kvm_sys_reg_table_init>> valid &= check_sysreg_table(sys_insn_descs, ARRAY_SIZE(sys_insn_descs), false);
+	 *   - arch/arm64/kvm/sys_regs.c|5685| <<kvm_sys_reg_table_init>> for (i = 0; !ret && i < ARRAY_SIZE(sys_insn_descs); i++)
+	 *   - arch/arm64/kvm/sys_regs.c|5686| <<kvm_sys_reg_table_init>> ret = populate_sysreg_config(sys_insn_descs + i, i);
+	 */
 	/* System registers have Op0=={2,3}, as per DDI487 J.a C5.1.2 */
 	if (params.Op0 == 2 || params.Op0 == 3)
 		desc = &sys_reg_descs[sr_idx];
@@ -5665,6 +5691,14 @@ int __init kvm_sys_reg_table_init(void)
 	valid &= check_sysreg_table(cp14_64_regs, ARRAY_SIZE(cp14_64_regs), false);
 	valid &= check_sysreg_table(cp15_regs, ARRAY_SIZE(cp15_regs), false);
 	valid &= check_sysreg_table(cp15_64_regs, ARRAY_SIZE(cp15_64_regs), false);
+	/*
+	 * 在以下使用sys_insn_descs[]:
+	 *   - arch/arm64/kvm/sys_regs.c|4102| <<global>> static struct sys_reg_desc sys_insn_descs[] = {
+	 *   - arch/arm64/kvm/sys_regs.c|5181| <<kvm_handle_sys_reg>> desc = &sys_insn_descs[sr_idx];
+	 *   - arch/arm64/kvm/sys_regs.c|5668| <<kvm_sys_reg_table_init>> valid &= check_sysreg_table(sys_insn_descs, ARRAY_SIZE(sys_insn_descs), false);
+	 *   - arch/arm64/kvm/sys_regs.c|5685| <<kvm_sys_reg_table_init>> for (i = 0; !ret && i < ARRAY_SIZE(sys_insn_descs); i++)
+	 *   - arch/arm64/kvm/sys_regs.c|5686| <<kvm_sys_reg_table_init>> ret = populate_sysreg_config(sys_insn_descs + i, i);
+	 */
 	valid &= check_sysreg_table(sys_insn_descs, ARRAY_SIZE(sys_insn_descs), false);
 
 	gicv3_regs = vgic_v3_get_sysreg_table(&sz);
diff --git a/arch/x86/events/amd/core.c b/arch/x86/events/amd/core.c
index 44656d2fb..4cda7836c 100644
--- a/arch/x86/events/amd/core.c
+++ b/arch/x86/events/amd/core.c
@@ -740,6 +740,11 @@ static void amd_pmu_check_overflow(void)
 	 * ARCH_PERFMON_EVENTSEL_INT is always set.
 	 */
 	for_each_set_bit(idx, x86_pmu.cntr_mask, X86_PMC_IDX_MAX) {
+		/*
+		 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+		 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+		 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+		 */
 		if (!test_bit(idx, cpuc->active_mask))
 			continue;
 
@@ -760,6 +765,11 @@ static void amd_pmu_enable_all(int added)
 	amd_brs_enable_all();
 
 	for_each_set_bit(idx, x86_pmu.cntr_mask, X86_PMC_IDX_MAX) {
+		/*
+		 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+		 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+		 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+		 */
 		/* only activate events which are marked as active */
 		if (!test_bit(idx, cpuc->active_mask))
 			continue;
@@ -989,11 +999,26 @@ static int amd_pmu_v2_handle_irq(struct pt_regs *regs)
 	status &= amd_pmu_global_cntr_mask;
 
 	for_each_set_bit(idx, x86_pmu.cntr_mask, X86_PMC_IDX_MAX) {
+		/*
+		 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+		 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+		 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+		 */
 		if (!test_bit(idx, cpuc->active_mask))
 			continue;
 
 		event = cpuc->events[idx];
 		hwc = &event->hw;
+		/*
+		 * 在以下使用x86_perf_event_update():
+		 *   - arch/x86/events/amd/core.c|997| <<amd_pmu_v2_handle_irq>> x86_perf_event_update(event);
+		 *   - arch/x86/events/core.c|2171| <<init_hw_perf_events>> x86_pmu.update = x86_perf_event_update;
+		 *   - arch/x86/events/intel/core.c|2882| <<intel_pmu_read_event>> x86_perf_event_update(event);
+		 *   - arch/x86/events/intel/core.c|3178| <<intel_pmu_update>> return x86_perf_event_update(event);
+		 *   - arch/x86/events/intel/p4.c|1063| <<p4_pmu_handle_irq>> val = x86_perf_event_update(event);
+		 *   - arch/x86/events/perf_event.h|1198| <<intel_pmu_topdown_event_update>> return x86_perf_event_update(event);
+		 *   - arch/x86/events/zhaoxin/core.c|395| <<zhaoxin_pmu_handle_irq>> x86_perf_event_update(event);
+		 */
 		x86_perf_event_update(event);
 		mask = BIT_ULL(idx);
 
diff --git a/arch/x86/events/core.c b/arch/x86/events/core.c
index 576baa9a5..83ad409e2 100644
--- a/arch/x86/events/core.c
+++ b/arch/x86/events/core.c
@@ -122,6 +122,16 @@ u64 __read_mostly hw_cache_extra_regs
  * Can only be executed on the CPU where the event is active.
  * Returns the delta events processed.
  */
+/*
+ * 在以下使用x86_perf_event_update():
+ *   - arch/x86/events/amd/core.c|997| <<amd_pmu_v2_handle_irq>> x86_perf_event_update(event);
+ *   - arch/x86/events/core.c|2171| <<init_hw_perf_events>> x86_pmu.update = x86_perf_event_update;
+ *   - arch/x86/events/intel/core.c|2882| <<intel_pmu_read_event>> x86_perf_event_update(event);
+ *   - arch/x86/events/intel/core.c|3178| <<intel_pmu_update>> return x86_perf_event_update(event);
+ *   - arch/x86/events/intel/p4.c|1063| <<p4_pmu_handle_irq>> val = x86_perf_event_update(event);
+ *   - arch/x86/events/perf_event.h|1198| <<intel_pmu_topdown_event_update>> return x86_perf_event_update(event);
+ *   - arch/x86/events/zhaoxin/core.c|395| <<zhaoxin_pmu_handle_irq>> x86_perf_event_update(event);
+ */
 u64 x86_perf_event_update(struct perf_event *event)
 {
 	struct hw_perf_event *hwc = &event->hw;
@@ -708,6 +718,11 @@ void x86_pmu_disable_all(void)
 		struct hw_perf_event *hwc = &cpuc->events[idx]->hw;
 		u64 val;
 
+		/*
+		 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+		 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+		 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+		 */
 		if (!test_bit(idx, cpuc->active_mask))
 			continue;
 		rdmsrq(x86_pmu_config_addr(idx), val);
@@ -764,6 +779,11 @@ void x86_pmu_enable_all(int added)
 	for_each_set_bit(idx, x86_pmu.cntr_mask, X86_PMC_IDX_MAX) {
 		struct hw_perf_event *hwc = &cpuc->events[idx]->hw;
 
+		/*
+		 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+		 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+		 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+		 */
 		if (!test_bit(idx, cpuc->active_mask))
 			continue;
 
@@ -1543,6 +1563,11 @@ static void x86_pmu_start(struct perf_event *event, int flags)
 
 	event->hw.state = 0;
 
+	/*
+	 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+	 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+	 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+	 */
 	__set_bit(idx, cpuc->active_mask);
 	static_call(x86_pmu_enable)(event);
 	perf_event_update_userpage(event);
@@ -1618,6 +1643,11 @@ void x86_pmu_stop(struct perf_event *event, int flags)
 	struct cpu_hw_events *cpuc = this_cpu_ptr(&cpu_hw_events);
 	struct hw_perf_event *hwc = &event->hw;
 
+	/*
+	 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+	 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+	 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+	 */
 	if (test_bit(hwc->idx, cpuc->active_mask)) {
 		static_call(x86_pmu_disable)(event);
 		__clear_bit(hwc->idx, cpuc->active_mask);
@@ -1718,13 +1748,37 @@ int x86_pmu_handle_irq(struct pt_regs *regs)
 	apic_write(APIC_LVTPC, APIC_DM_NMI);
 
 	for_each_set_bit(idx, x86_pmu.cntr_mask, X86_PMC_IDX_MAX) {
+		/*
+		 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+		 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+		 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+		 */
 		if (!test_bit(idx, cpuc->active_mask))
 			continue;
 
 		event = cpuc->events[idx];
 		last_period = event->hw.last_period;
 
+		/*
+		 * 在以下使用x86_perf_event_update():
+		 *   - arch/x86/events/amd/core.c|997| <<amd_pmu_v2_handle_irq>> x86_perf_event_update(event);
+		 *   - arch/x86/events/core.c|2171| <<init_hw_perf_events>> x86_pmu.update = x86_perf_event_update;
+		 *   - arch/x86/events/intel/core.c|2882| <<intel_pmu_read_event>> x86_perf_event_update(event);
+		 *   - arch/x86/events/intel/core.c|3178| <<intel_pmu_update>> return x86_perf_event_update(event);
+		 *   - arch/x86/events/intel/p4.c|1063| <<p4_pmu_handle_irq>> val = x86_perf_event_update(event);
+		 *   - arch/x86/events/perf_event.h|1198| <<intel_pmu_topdown_event_update>> return x86_perf_event_update(event);
+		 *   - arch/x86/events/zhaoxin/core.c|395| <<zhaoxin_pmu_handle_irq>> x86_perf_event_update(event);
+		 *
+		 *
+		 * x86_perf_event_update()
+		 */
 		val = static_call(x86_pmu_update)(event);
+		/*
+		 * cntval_bits在AMD上是48 (0-47是counter的bit)
+		 * x86_pmu.cntval_bits - 1就是47
+		 * 1往左移动47就是bit=47
+		 * 这个bit如果是1就是overflow了
+		 */
 		if (val & (1ULL << (x86_pmu.cntval_bits - 1)))
 			continue;
 
@@ -1775,6 +1829,10 @@ perf_event_nmi_handler(unsigned int cmd, struct pt_regs *regs)
 		return NMI_DONE;
 
 	start_clock = sched_clock();
+	/*
+	 * amd_pmu_handle_irq()
+	 * amd_pmu_v2_handle_irq()
+	 */
 	ret = static_call(x86_pmu_handle_irq)(regs);
 	finish_clock = sched_clock();
 
@@ -2167,6 +2225,16 @@ static int __init init_hw_perf_events(void)
 	if (!x86_pmu.set_period)
 		x86_pmu.set_period = x86_perf_event_set_period;
 
+	/*
+	 * 在以下使用x86_perf_event_update():
+	 *   - arch/x86/events/amd/core.c|997| <<amd_pmu_v2_handle_irq>> x86_perf_event_update(event);
+	 *   - arch/x86/events/core.c|2171| <<init_hw_perf_events>> x86_pmu.update = x86_perf_event_update;
+	 *   - arch/x86/events/intel/core.c|2882| <<intel_pmu_read_event>> x86_perf_event_update(event);
+	 *   - arch/x86/events/intel/core.c|3178| <<intel_pmu_update>> return x86_perf_event_update(event);
+	 *   - arch/x86/events/intel/p4.c|1063| <<p4_pmu_handle_irq>> val = x86_perf_event_update(event);
+	 *   - arch/x86/events/perf_event.h|1198| <<intel_pmu_topdown_event_update>> return x86_perf_event_update(event);
+	 *   - arch/x86/events/zhaoxin/core.c|395| <<zhaoxin_pmu_handle_irq>> x86_perf_event_update(event);
+	 */
 	if (!x86_pmu.update)
 		x86_pmu.update = x86_perf_event_update;
 
diff --git a/arch/x86/events/perf_event.h b/arch/x86/events/perf_event.h
index ad35c5462..cce5d7616 100644
--- a/arch/x86/events/perf_event.h
+++ b/arch/x86/events/perf_event.h
@@ -256,6 +256,11 @@ struct cpu_hw_events {
 	 * Generic x86 PMC bits
 	 */
 	struct perf_event	*events[X86_PMC_IDX_MAX]; /* in counter order */
+	/*
+	 * 在以下修改cpu_hw_events->active_mask[BITS_TO_LONGS(MAX_HWEVENTS)]:
+	 *   - arch/x86/events/core.c|1546| <<x86_pmu_start>> __set_bit(idx, cpuc->active_mask);
+	 *   - arch/x86/events/core.c|1623| <<x86_pmu_stop>> __clear_bit(hwc->idx, cpuc->active_mask);
+	 */
 	unsigned long		active_mask[BITS_TO_LONGS(X86_PMC_IDX_MAX)];
 	unsigned long		dirty[BITS_TO_LONGS(X86_PMC_IDX_MAX)];
 	int			enabled;
diff --git a/arch/x86/include/asm/irq_remapping.h b/arch/x86/include/asm/irq_remapping.h
index 4e55d1755..8c0f155ce 100644
--- a/arch/x86/include/asm/irq_remapping.h
+++ b/arch/x86/include/asm/irq_remapping.h
@@ -17,6 +17,18 @@
 struct msi_msg;
 struct irq_alloc_info;
 
+/*
+ * 在以下使用IRQ_POSTING_CAP:
+ *   - arch/x86/include/asm/irq_remapping.h|21| <<global>> IRQ_POSTING_CAP = 0,
+ *   - arch/x86/include/asm/irq_remapping.h|72| <<posted_msi_supported>> return enable_posted_msi && irq_remapping_cap(IRQ_POSTING_CAP);
+ *   - arch/x86/kvm/x86.c|10115| <<kvm_x86_vendor_init>> irq_remapping_cap(IRQ_POSTING_CAP);
+ *   - drivers/iommu/amd/init.c|3144| <<enable_iommus_vapic>> amd_iommu_irq_ops.capability |= (1 << IRQ_POSTING_CAP);
+ *   - drivers/iommu/amd/init.c|3158| <<disable_iommus>> amd_iommu_irq_ops.capability &= ~(1 << IRQ_POSTING_CAP);
+ *   - drivers/iommu/intel/irq_remapping.c|786| <<set_irq_posting_cap>> intel_irq_remap_ops.capability |= 1 << IRQ_POSTING_CAP;
+ *   - drivers/iommu/intel/irq_remapping.c|791| <<set_irq_posting_cap>> intel_irq_remap_ops.capability &= ~(1 << IRQ_POSTING_CAP);
+ *   - drivers/iommu/intel/irq_remapping.c|1029| <<disable_irq_remapping>> intel_irq_remap_ops.capability &= ~(1 << IRQ_POSTING_CAP);
+ *   - drivers/iommu/intel/irq_remapping.c|1584| <<dmar_ir_hotplug>> if (irq_remapping_cap(IRQ_POSTING_CAP) &&
