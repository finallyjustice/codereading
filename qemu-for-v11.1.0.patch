diff --git a/include/qemu/rcu.h b/include/qemu/rcu.h
index 020dbe4d8..af2ac5779 100644
--- a/include/qemu/rcu.h
+++ b/include/qemu/rcu.h
@@ -178,6 +178,27 @@ static inline void rcu_read_auto_unlock(RCUReadAuto *r)
 
 G_DEFINE_AUTOPTR_CLEANUP_FUNC(RCUReadAuto, rcu_read_auto_unlock)
 
+/*
+ * WITH_RCU_READ_LOCK_GUARD()核心技巧是用 for 循环制造一个作用域:
+ *
+ * 1. 初始化时调用 rcu_read_auto_lock(), 里面执行 rcu_read_lock()
+ * 2. 循环体执行你的代码
+ * 3. 离开循环时调用 rcu_read_auto_unlock(), 里面执行 rcu_read_unlock()
+ *
+ * QTAILQ_FOREACH_RCU 本身不是"加锁", 也不是完整的 RCU 机制; 它主要是 用
+ * RCU/atomic 读法遍历链表指针.
+ * 也就是说, 它和普通 QTAILQ_FOREACH 的区别是读链表指针时用:
+ * qatomic_rcu_read(...)
+ *
+ * qatomic_rcu_read() 的作用主要是:
+ * - 用 atomic load 读指针;
+ * - 带合适的内存顺序/屏障语义;
+ * - 保证 reader 看到的节点内容和 writer 发布节点时的初始化顺序一致.
+ *
+ * 两者分工是:
+ * - WITH_RCU_READ_LOCK_GUARD(): 告诉 RCU 系统"我正在读, 旧节点别 free"
+ * - QTAILQ_FOREACH_RCU(): 用 RCU 安全的 atomic load 读链表 next 指针
+ */
 #define WITH_RCU_READ_LOCK_GUARD() \
     WITH_RCU_READ_LOCK_GUARD_(glue(_rcu_read_auto, __COUNTER__))
 
