+/*
+ * 因为 cpr-exec 后的新 QEMU 不是新 fork 的普通进程. 它是旧 QEMU 直接 execve()
+ * 出来的, 因而已经继承旧进程做完的 OS 级设置.
+ *
+ * os_setup_post() 在 POSIX 上会做:
+ *
+ * daemonize 时:
+ *   chdir("/")
+ *   打开 /dev/null
+ *   dup2 stdin/stdout/stderr
+ *   向 daemon_pipe 写 "启动完成"
+ *
+ * 所有情况:
+ *   change_root()          // chroot
+ *   change_process_uid()   // setuid/setgid
+ *
+ * 对 cpr-exec, 旧 QEMU 在第一次启动时已执行过这些操作:
+ *
+ * 旧 QEMU:
+ *   chroot/setuid/daemon redirect 完成
+ *   ...
+ *   execvp(new-qemu, argv)
+ *
+ * 新 QEMU:
+ *   继承 cwd, root, uid/gid, stdin/out/err, daemon 状态
+ *
+ * 若再执行 os_setup_post():
+ *
+ * 重复 chroot
+ * 重复 drop uid/gid
+ * 再次处理 daemon_pipe, 但原 daemon pipe 已完成/可能关闭
+ * 重复重定向 stdio
+ *
+ * 可能失败或破坏继承状态.
+ *
+ * 所以新 QEMU 通过启动早期 cpr_state_load() 已知当前是 MIG_MODE_CPR_EXEC,
+ * 因而跳过 os_setup_post():
+ *
+ * if (migrate_mode() != MIG_MODE_CPR_EXEC) {
+ *     os_setup_post();
+ * }
+ */
 void os_setup_post(void)
 {
     int fd = 0;
