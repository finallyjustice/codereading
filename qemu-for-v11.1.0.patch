diff --git a/backends/hostmem.c b/backends/hostmem.c
index 5dd5fb155..7274e6074 100644
--- a/backends/hostmem.c
+++ b/backends/hostmem.c
@@ -331,6 +331,65 @@ size_t host_memory_backend_pagesize(HostMemoryBackend *memdev)
     return pagesize;
 }
 
+/*
+ * QEMU command line:
+ *     -object memory-backend-memfd,id=ram0,size=16G,...
+ *
+ *   system/vl.c:
+ *     qemu_create_early_backends()
+ *       -> object_option_foreach_add(object_create_early)
+ *         -> user_creatable_add_qapi(opt->opts, &error_fatal)
+ *
+ *   qom/object_interfaces.c:
+ *     user_creatable_add_qapi()
+ *       -> object_new_with_props_from_qdict(
+ *            "memory-backend-memfd",
+ *            /objects,
+ *            "ram0",
+ *            ...)
+ *
+ *   qom/object.c:
+ *     object_new_with_props_helper()
+ *       -> object_new_with_type()
+ *          // new HostMemoryBackendMemfd object
+ *       -> set_props()
+ *          // 设置 size, share, prealloc, ...
+ *       -> object_property_try_add_child(/objects, "ram0", obj)
+ *       -> user_creatable_complete(uc, errp)
+ *
+ *   qom/object_interfaces.c:
+ *     user_creatable_complete()
+ *       -> ucc->complete(uc, errp)
+ *
+ *   backends/hostmem.c:
+ *     host_memory_backend_memory_complete()
+ */
+/*
+ * host_memory_backend_memory_complete() 是 -object memory-backend-* 的
+ * "属性都设置完了, 现在真正创建这块 host memory" 的统一入口.
+ *
+ * 例如:
+ *
+ * -object memory-backend-memfd,id=ram0,size=16G,share=on,prealloc=on
+ *
+ * QEMU 先创建一个空 HostMemoryBackend object, 设置 id, size, share, prealloc
+ * 等属性. 最后调用:
+ *
+ * ucc->complete = host_memory_backend_memory_complete;
+ *
+ * 这个函数做的顺序是:
+ *
+ * 1. 调子类的 alloc().
+ * 2. 得到 host virtual address, size, page size.
+ * 3. 检查 size 是否是 page size 的整数倍.
+ * 4. 设置 madvise: merge, dump.
+ * 5. 设置 NUMA policy.
+ * 6. 如 prealloc=on, 预先 fault-in/分配所有页.
+ *
+ *
+ * 在以下使用host_memory_backend_memory_complete():
+ *   - backends/hostmem.c|513| <<host_memory_backend_class_init>> ucc->complete = host_memory_backend_memory_complete;
+ */
 static void
 host_memory_backend_memory_complete(UserCreatable *uc, Error **errp)
 {
diff --git a/backends/iommufd.c b/backends/iommufd.c
index 15f2a5135..66fb910f6 100644
--- a/backends/iommufd.c
+++ b/backends/iommufd.c
@@ -85,6 +85,19 @@ static void iommufd_backend_complete(UserCreatable *uc, Error **errp)
         if (cpr_is_incoming()) {
             be->fd = cpr_find_fd(name, 0);
         } else {
+            /*
+	     * 在以下使用cpr_save_fd():
+             *   - backends/hostmem-memfd.c|57| <<memfd_backend_memory_alloc>> cpr_save_fd(name, 0, fd);
+             *   - backends/hostmem-shm.c|51| <<shm_backend_memory_alloc>> cpr_save_fd(backend_name, 0, fd);
+             *   - backends/iommufd.c|88| <<iommufd_backend_complete>> cpr_save_fd(name, 0, be->fd);
+             *   - hw/vfio/cpr-legacy.c|265| <<vfio_cpr_group_get_device_fd>> cpr_save_fd(name, id, fd);
+             *   - hw/vfio/cpr-legacy.c|294| <<vfio_cpr_container_match>> cpr_save_fd("vfio_container_for_group", group->groupid, container->fd);
+             *   - hw/vfio/cpr.c|39| <<vfio_cpr_save_vector_fd>> cpr_save_fd(fdname, nr, fd);
+             *   - migration/cpr.c|179| <<cpr_resave_fd>> cpr_save_fd(name, id, fd);
+             *   - migration/cpr.c|196| <<cpr_open_fd>> cpr_save_fd(name, id, fd);
+             *   - migration/cpr.c|404| <<cpr_get_fd_param>> cpr_save_fd(name, index, fd);
+             *   - system/physmem.c|2451| <<qemu_ram_get_shared_fd>> cpr_save_fd(name, 0, fd);
+	     */
             cpr_save_fd(name, 0, be->fd);
         }
     } else if (!g_file_test("/dev/iommu", G_FILE_TEST_EXISTS)) {
@@ -114,6 +127,10 @@ bool iommufd_change_process_capable(IOMMUFDBackend *be)
     return !ioctl(be->fd, IOMMU_IOAS_CHANGE_PROCESS, &args);
 }
 
+/*
+ * 在以下使用iommufd_change_process():
+ *   - hw/vfio/cpr-iommufd.c|170| <<iommufd_cpr_post_load>> if (!iommufd_change_process(be, &local_err)) {
+ */
 bool iommufd_change_process(IOMMUFDBackend *be, Error **errp)
 {
     struct iommu_ioas_change_process args = {.size = sizeof(args)};
@@ -132,6 +149,11 @@ bool iommufd_backend_connect(IOMMUFDBackend *be, Error **errp)
     int fd;
 
     if (be->owned && !be->users) {
+        /*
+	 * 在以下使用cpr_open_fd():
+         *   - backends/iommufd.c|148| <<iommufd_backend_connect>> fd = cpr_open_fd("/dev/iommu", O_RDWR, iommufd_fd_name(be), 0, errp);
+         *   - hw/vfio/container-legacy.c|795| <<vfio_group_get>> group->fd = cpr_open_fd(path, O_RDWR, "vfio_group", groupid, errp);
+	 */
         fd = cpr_open_fd("/dev/iommu", O_RDWR, iommufd_fd_name(be), 0, errp);
         if (fd < 0) {
             return false;
@@ -275,6 +297,11 @@ int iommufd_backend_map_file_dma(IOMMUFDBackend *be, uint32_t ioas_id,
     return ret;
 }
 
+/*
+ * 在以下使用iommufd_backend_unmap_dma():
+ *   - hw/vfio/iommufd.c|111| <<iommufd_cdev_unmap>> unmap_ret = iommufd_backend_unmap_dma(be, ioas_id, iova, size);
+ *   - hw/vfio/iommufd.c|124| <<iommufd_cdev_unmap>> ret = iommufd_backend_unmap_dma(be, ioas_id, iova, size);
+ */
