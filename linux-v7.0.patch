+ * 在以下使用vgic_v3_attr_regs_access():
+ *   - arch/arm64/kvm/vgic/vgic-kvm-device.c|630| <<vgic_v3_set_attr>> return vgic_v3_attr_regs_access(dev, attr, true);
+ *   - arch/arm64/kvm/vgic/vgic-kvm-device.c|661| <<vgic_v3_get_attr>> return vgic_v3_attr_regs_access(dev, attr, false);
+ */
 static int vgic_v3_attr_regs_access(struct kvm_device *dev,
 				    struct kvm_device_attr *attr,
 				    bool is_write)
@@ -627,6 +632,11 @@ static int vgic_v3_set_attr(struct kvm_device *dev,
 	case KVM_DEV_ARM_VGIC_GRP_REDIST_REGS:
 	case KVM_DEV_ARM_VGIC_GRP_CPU_SYSREGS:
 	case KVM_DEV_ARM_VGIC_GRP_LEVEL_INFO:
+		/*
+		 * 在以下使用vgic_v3_attr_regs_access():
+		 *   - arch/arm64/kvm/vgic/vgic-kvm-device.c|630| <<vgic_v3_set_attr>> return vgic_v3_attr_regs_access(dev, attr, true);
+		 *   - arch/arm64/kvm/vgic/vgic-kvm-device.c|661| <<vgic_v3_get_attr>> return vgic_v3_attr_regs_access(dev, attr, false);
+		 */
 		return vgic_v3_attr_regs_access(dev, attr, true);
 	case KVM_DEV_ARM_VGIC_GRP_MAINT_IRQ: {
 		u32 __user *uaddr = (u32 __user *)attr->addr;
@@ -658,6 +668,11 @@ static int vgic_v3_get_attr(struct kvm_device *dev,
 	case KVM_DEV_ARM_VGIC_GRP_REDIST_REGS:
 	case KVM_DEV_ARM_VGIC_GRP_CPU_SYSREGS:
