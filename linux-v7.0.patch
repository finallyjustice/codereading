@@ -3551,7 +3562,25 @@ int kvm_apic_accept_events(struct kvm_vcpu *vcpu)
 		return 0;
 	}
 
+	/*
+	 * 在以下使用KVM_APIC_INIT:
+	 *   - arch/x86/kvm/lapic.c|1461| <<__apic_accept_irq>> apic->pending_events = (1UL << KVM_APIC_INIT);
+	 *   - arch/x86/kvm/lapic.c|3554| <<kvm_apic_accept_events>> if (test_and_clear_bit(KVM_APIC_INIT, &apic->pending_events)) {
+	 *   - arch/x86/kvm/lapic.h|236| <<kvm_lapic_latched_init>> return lapic_in_kernel(vcpu) && test_bit(KVM_APIC_INIT, &vcpu->arch.apic->pending_events);
+	 *   - arch/x86/kvm/svm/nested.c|1606| <<svm_check_nested_events>> test_bit(KVM_APIC_INIT, &apic->pending_events)) {
+	 *   - arch/x86/kvm/vmx/nested.c|4314| <<vmx_check_nested_events>> test_bit(KVM_APIC_INIT, &apic->pending_events)) {
