 DEFINE_PER_CPU(struct pvclock_vsyscall_time_info *, hv_clock_per_cpu);
 EXPORT_PER_CPU_SYMBOL_GPL(hv_clock_per_cpu);
 
+/*
+ * [0] kvm_get_wallclock
+ * [0] read_persistent_wall_and_boot_offset
