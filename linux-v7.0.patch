 	if (!has_steal_clock)
 		return;
 
@@ -489,6 +531,29 @@ static int kvm_cpu_online(unsigned int cpu)
 
 static DEFINE_PER_CPU(cpumask_var_t, __pv_cpu_mask);
 
+/*
+ * 关于KVM_FEATURE_PV_TLB_FLUSH:
+ * 
+ * 当target cpu被preempted (KVM_VCPU_PREEMPTED)的时候就不用ipi了,直接设置KVM_VCPU_FLUSH_TLB,
+ * 这样当vcpu enter的时候可以kvm_vcpu_flush_tlb_guest().
+ * 总之减少了ipi的次数
+ *
+ * 支持pv tlb flush的情况
+ *
+ * 505 static bool pv_tlb_flush_supported(void)
+ * 506 {
+ * 507         return (kvm_para_has_feature(KVM_FEATURE_PV_TLB_FLUSH) &&
+ * 508                 !kvm_para_has_hint(KVM_HINTS_REALTIME) &&
+ * 509                 kvm_para_has_feature(KVM_FEATURE_STEAL_TIME) &&
+ * 510                 !boot_cpu_has(X86_FEATURE_MWAIT) &&
+ * 511                 (num_possible_cpus() != 1));
+ * 512 }
+ *
+ *
+ * 在以下使用pv_tlb_flush_supported():
+ *   - arch/x86/kernel/kvm.c|703| <<kvm_alloc_cpumask>> if (pv_tlb_flush_supported() || pv_ipi_supported())
+ *   - arch/x86/kernel/kvm.c|860| <<kvm_guest_init>> if (pv_tlb_flush_supported()) {
+ */
 static bool pv_tlb_flush_supported(void)
 {
 	return (kvm_para_has_feature(KVM_FEATURE_PV_TLB_FLUSH) &&
@@ -700,6 +765,11 @@ static __init int kvm_alloc_cpumask(void)
 	if (!kvm_para_available() || nopv)
 		return 0;
 
+	/*
+	 * 在以下使用pv_tlb_flush_supported():
+	 *   - arch/x86/kernel/kvm.c|703| <<kvm_alloc_cpumask>> if (pv_tlb_flush_supported() || pv_ipi_supported())
+	 *   - arch/x86/kernel/kvm.c|860| <<kvm_guest_init>> if (pv_tlb_flush_supported()) {
+	 */
 	if (pv_tlb_flush_supported() || pv_ipi_supported())
 		for_each_possible_cpu(cpu) {
 			zalloc_cpumask_var_node(per_cpu_ptr(&__pv_cpu_mask, cpu),
@@ -839,6 +909,14 @@ static void __init kvm_guest_init(void)
 		raw_spin_lock_init(&async_pf_sleepers[i].lock);
 
 	if (kvm_para_has_feature(KVM_FEATURE_STEAL_TIME)) {
+		/*
+		 * 在以下使用has_steal_clock:
+		 *   - arch/x86/kernel/kvm.c|342| <<kvm_register_steal_time>> if (!has_steal_clock)
+		 *   - arch/x86/kernel/kvm.c|397| <<kvm_guest_cpu_init>> if (has_steal_clock)
+		 *   - arch/x86/kernel/kvm.c|414| <<kvm_disable_steal_time>> if (!has_steal_clock)
+		 *   - arch/x86/kernel/kvm.c|842| <<kvm_guest_init>> has_steal_clock = 1;
+		 *   - arch/x86/kernel/kvm.c|1059| <<activate_jump_labels>> if (has_steal_clock) {
+		 */
 		has_steal_clock = 1;
 		static_call_update(pv_steal_clock, kvm_steal_clock);
 
@@ -857,6 +935,11 @@ static void __init kvm_guest_init(void)
 	}
 
 #ifdef CONFIG_SMP
+	/*
+	 * 在以下使用pv_tlb_flush_supported():
+	 *   - arch/x86/kernel/kvm.c|703| <<kvm_alloc_cpumask>> if (pv_tlb_flush_supported() || pv_ipi_supported())
+	 *   - arch/x86/kernel/kvm.c|860| <<kvm_guest_init>> if (pv_tlb_flush_supported()) {
+	 */
 	if (pv_tlb_flush_supported()) {
 		pv_ops.mmu.flush_tlb_multi = kvm_flush_tlb_multi;
 		pr_info("KVM setup pv remote TLB flush\n");
@@ -1056,6 +1139,14 @@ const __initconst struct hypervisor_x86 x86_hyper_kvm = {
 
 static __init int activate_jump_labels(void)
 {
+	/*
+	 * 在以下使用has_steal_clock:
+	 *   - arch/x86/kernel/kvm.c|342| <<kvm_register_steal_time>> if (!has_steal_clock)
+	 *   - arch/x86/kernel/kvm.c|397| <<kvm_guest_cpu_init>> if (has_steal_clock)
+	 *   - arch/x86/kernel/kvm.c|414| <<kvm_disable_steal_time>> if (!has_steal_clock)
+	 *   - arch/x86/kernel/kvm.c|842| <<kvm_guest_init>> has_steal_clock = 1;
+	 *   - arch/x86/kernel/kvm.c|1059| <<activate_jump_labels>> if (has_steal_clock) {
+	 */
 	if (has_steal_clock) {
 		static_key_slow_inc(&paravirt_steal_enabled);
 		if (steal_acc)
diff --git a/arch/x86/kernel/kvmclock.c b/arch/x86/kernel/kvmclock.c
