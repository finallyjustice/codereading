+ *   - arch/x86/kernel/kvm.c|842| <<kvm_guest_init>> has_steal_clock = 1;
+ *   - arch/x86/kernel/kvm.c|1059| <<activate_jump_labels>> if (has_steal_clock) {
+ */
 static int has_steal_clock = 0;
 
 static int has_guest_poll = 0;
@@ -337,8 +345,26 @@ static void __init paravirt_ops_setup(void)
 static void kvm_register_steal_time(void)
 {
 	int cpu = smp_processor_id();
