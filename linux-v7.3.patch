+	 *               vq, vq->heads, vq->nheads, count);
+	 *
+	 *
+	 * vq->heads     完成记录数组的地址, 前501条有效
+	 * vq->nheads    另一个数组的地址, OOO 分支不使用它
+	 * count         数值 501, 表示要写回多少条记录
+	 */
 	vhost_add_used_and_signal_n(dev, vq, vq->heads,
 				    vq->nheads, count);
 	nvq->done_idx = 0;
 }
 
