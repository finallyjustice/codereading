+ * 3. 设置 nvq->done_idx = 0: 下一批重新累计.
+ *
+ * 参数 count 表示要写回多少条完成记录, IN_ORDER 下, 一条记录可能代表多个
+ * buffer, 所以 count 可以小于 done_idx.
+ *
+ * 这里"清空"只是计数归零, 不会把 heads[] 数组内容清零.
+ * RX 路径里，heads[] 复用时不整体清零, 下一批直接覆盖有效部分
+ */
 static void vhost_net_signal_used(struct vhost_net_virtqueue *nvq,
 				  unsigned int count)
 {
@@ -481,11 +607,32 @@ static void vhost_net_signal_used(struct vhost_net_virtqueue *nvq,
 	if (!nvq->done_idx)
 		return;
 
+	/*
+	 * 在以下使用vhost_add_used_and_signal_n():
+	 *   - drivers/vhost/net.c|456| <<vhost_zerocopy_signal_used>> vhost_add_used_and_signal_n(vq->dev,
