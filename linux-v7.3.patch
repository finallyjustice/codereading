+/*
+ * 在以下使用vhost_net_signal_used():
+ *   - drivers/vhost/net.c|534| <<vhost_tx_batch>> vhost_net_signal_used(nvq, in_order ? 1 : nvq->done_idx);
+ *   - drivers/vhost/net.c|1068| <<vhost_net_rx_peek_head_len>> vhost_net_signal_used(rnvq, *count);
